{
  "manifest_version": 3,
  "name": "貼り込み係（統合小説執筆環境の相棒）",
  "version": "0.4.0",
  "description": "母艦でコピーした原稿を、自分で開いた投稿画面の欄へ入れる拡張。自分の管理画面の読者の反応をコピーもできます。通信はせず、投稿ボタンも押しません。",
  "permissions": ["clipboardRead", "clipboardWrite", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "貼り込み係"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kakuyomu.jp/my/works/*",
        "https://kakuyomu.jp/works/*/accesses",
        "https://www.alphapolis.co.jp/manage/*",
        "https://www.alphapolis.co.jp/author/*",
        "https://www.alphapolis.co.jp/novel/*"
      ],
      "js": [
        "common/messages.js",
        "common/guard.js",
        "common/match.js",
        "content/sites.js",
        "content/statsSites.js",
        "content/fill.js",
        "content/read.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
