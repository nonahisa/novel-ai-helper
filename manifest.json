{
  "manifest_version": 3,
  "name": "統合小説執筆環境ヘルパー",
  "version": "0.12.2",
  "description": "ご自分の作品の読者の反応（PV・ブックマーク・評価）を管理画面を開いたときに記録し、作品ごとに推移や離脱率を簡単に集計します。VS Code の「統合小説執筆環境」と一緒に使えば、原稿を投稿画面の欄へ入れることもできます。通信はしません。",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "notifications",
    "contextMenus",
    "offscreen",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "統合小説執筆環境ヘルパー",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "24": "icons/toolbar24.png",
      "32": "icons/toolbar32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://kakuyomu.jp/my/works/*",
        "https://kakuyomu.jp/works/*/accesses",
        "https://kakuyomu.jp/works/*/accesses?*",
        "https://www.alphapolis.co.jp/manage/*",
        "https://www.alphapolis.co.jp/author/*",
        "https://www.alphapolis.co.jp/novel/*",
        "https://db.narou.fun/works/*"
      ],
      "js": [
        "common/messages.js",
        "common/guard.js",
        "common/match.js",
        "content/sites.js",
        "content/statsSites.js",
        "content/fill.js",
        "content/read.js",
        "content/announce.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://creative-story.net/bungakusyou/",
        "https://creative-story.net/bungakusyou/?*",
        "https://creative-story.net/202111contest/",
        "https://creative-story.net/202111contest/?*",
        "https://tsukuritemirai.com/kobo/novel/",
        "https://tsukuritemirai.com/kobo/novel/?*"
      ],
      "js": [
        "common/messages.js",
        "content/contestSites.js",
        "content/contestRead.js",
        "content/announce.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
